    {
      "id": "case-build-dockerfile-feature-image-name",
      "behaviors": [
        "bhv-build-features-extended-image"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "build",
        "sdim-config-source": "dockerfile",
        "sdim-container-state": "none",
        "sdim-features": "single",
        "sdim-layering": "cli-overlay",
        "sdim-output-mode": "human"
      },
      "inputClass": "valid",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-build",
          "subcommand": "build",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--image-name",
            "deacon-conformance-build:us3"
          ],
          "fixtures": [
            "fx-build-dockerfile-feature"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-build",
          "assertion": {
            "equals": 0
          }
        },
        {
          "channel": "chan-stdout",
          "operation": "op-build",
          "assertion": {
            "matches": "Image ID: deacon-devcontainer-features:[\\s\\S]*Tags:[^\\n]*deacon-conformance-build:us3"
          }
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "Covers the high-risk triple `hrt-build-dockerfile-cli-overlay-single-feature`. A Dockerfile build, a Feature layered on top of it, and a user-supplied `--image-name` — the exact combination in which this project once shipped a tag pointing at the PRE-Feature base. The assertion pins both halves in one ordered match: the reported image is the FEATURE-EXTENDED one (`deacon-devcontainer-features:…`), and the user's tag is among the tags applied to it. The stronger observation — running the tag and reading the Feature's marker — needs a `docker run` the declarative runner does not model, so the ordering constraint stands in for it and this note records the difference."
    },
