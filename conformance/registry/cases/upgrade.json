          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-upgrade",
          "assertion": {
            "equals": 0
          }
        },
        {
          "channel": "chan-structured-output",
          "operation": "op-upgrade",
          "assertion": {
            "jsonEquals": {
              "features": {}
            }
          }
        }
      ],
      "cleanup": {
        "tempdir": true
      },
      "notes": "FR-040 boundary class, and the direction half of a real divergence: a configuration with no Features regenerates to an EMPTY lockfile and exits 0. The empty document is the correct answer — there is nothing to pin — and pinning it here is what keeps the sibling differential from being read as 'deacon is wrong'."
    },
