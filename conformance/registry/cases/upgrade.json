            "${WORKSPACE}",
            "--dry-run"
          ],
          "fixtures": [
            "fx-errors-malformed-json"
          ],
          "expectFailurePhase": "config-resolution"
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-upgrade",
          "assertion": {
            "nonZero": true
          }
        }
      ],
      "cleanup": {
        "tempdir": true
      },
      "notes": "FR-040 malformed class: the Feature set to pin comes from the configuration, so an unparseable document has to stop the regeneration rather than produce an empty lockfile — which is a legitimate result for a different input and would be indistinguishable here."
    },
    {
      "id": "case-upgrade-no-features-differential",
      "behaviors": [
        "bhv-upgrade-empty-feature-set"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "upgrade",
        "sdim-config-source": "image",
        "sdim-container-state": "none",
        "sdim-features": "none",
        "sdim-layering": "single",
        "sdim-output-mode": "structured"
      },
      "inputClass": "reference-lenient",
      "oracleType": "live-differential",
      "operations": [
        {
          "id": "op-upgrade",
          "subcommand": "upgrade",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--dry-run"
          ],
          "fixtures": [
            "fx-up-basic"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-upgrade"
        }
      ],
      "allowedDifferences": [
        {
          "behavior": "bhv-upgrade-empty-feature-set",
          "context": [],
          "observablePath": "chan-exit-code.exitCode",
          "rationale": "deacon regenerates an empty lockfile and exits 0; the reference treats the empty Feature set as a failure and exits 1.",
          "waiverId": "wvr-upgrade-empty-feature-set"
        }
      ],
      "cleanup": {
        "tempdir": true
      },
      "notes": "The reference FAILS (`Failed to update lockfile`, exit 1) when asked to regenerate a lockfile for a configuration that declares no Features; deacon emits the empty lockfile and exits 0. Characterized rather than followed: an operation that cannot express 'nothing to pin' is unusable as an idempotent step, and the direction is pinned by the spec-expectation twin."
    },
    {
      "id": "case-upgrade-no-features-empty-lockfile",
      "behaviors": [
        "bhv-upgrade-empty-feature-set"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "upgrade",
        "sdim-config-source": "image",
