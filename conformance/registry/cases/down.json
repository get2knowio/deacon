{
  "schemaVersion": 1,
  "records": [
    {
      "id": "case-down-boundary-no-container",
      "behaviors": [
        "bhv-down-removes-container"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "down",
        "sdim-config-source": "image",
        "sdim-container-state": "none",
        "sdim-features": "none",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "boundary",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-down",
          "subcommand": "down",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--remove"
          ],
          "fixtures": [
            "fx-up-basic"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-down",
          "assertion": {
            "equals": 0
          }
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "FR-040 boundary class: tearing down a workspace that has no container. Removal of nothing is the degenerate end of the operation and must succeed — a `down` that failed here would be unusable as a cleanup step, which is how it is actually used."
    },
    {
      "id": "case-down-compose-project-teardown",
      "behaviors": [
        "bhv-down-compose-project-teardown"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "down",
        "sdim-config-source": "compose",
        "sdim-container-state": "running",
        "sdim-features": "none",
        "sdim-layering": "cli-overlay",
        "sdim-output-mode": "human"
      },
      "inputClass": "valid",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-down-compose"
          ]
        },
        {
          "id": "op-down",
          "subcommand": "down",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--remove",
            "--override-config",
            "${WORKSPACE}/.devcontainer/devcontainer.json"
          ]
        },
        {
          "id": "op-verify",
          "subcommand": "exec",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--",
            "true"
          ],
          "expectFailurePhase": "exec"
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-down",
          "assertion": {
            "equals": 0
          }
        },
        {
          "channel": "chan-exit-code",
          "operation": "op-verify",
          "assertion": {
            "nonZero": true
          }
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "Covers the high-risk triple `hrt-down-compose-running-cli-overlay`. Teardown identifies what to remove from the Compose project name and the workspace labels, both derived from the resolved configuration; a command-line overlay re-enters that derivation. If it does not reproduce what `up` used, `down` reports success and leaves the project running — which is why success is not the assertion: the following exec into the service container has to fail."
    },
