    {
      "id": "case-doctor-dockerfile-workspace",
      "behaviors": [
        "bhv-doctor-diagnostics-report"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "doctor",
        "sdim-config-source": "dockerfile",
        "sdim-container-state": "none",
        "sdim-features": "none",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "valid",
      "oracleType": "spec-expectation",
      "operations": [
        {
          "id": "op-doctor",
          "subcommand": "doctor",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-tier1-dockerfile-build"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-doctor",
          "assertion": {
            "equals": 0
          }
        },
        {
          "channel": "chan-stdout",
          "operation": "op-doctor",
          "assertion": {
            "contains": "Deacon Doctor Diagnostics"
          }
        }
      ],
      "cleanup": {
        "tempdir": true
      },
      "notes": "SC-004 requires every operation to carry a case for each configuration source the applicability rules permit for it. For `doctor` the configuration source is a property of the workspace it is pointed at rather than of the diagnosis, and that is exactly what the case shows: a Dockerfile-based workspace produces the same host and runtime report. An implementation that resolved the build before diagnosing would be slower and would fail where the diagnosis is most needed."
    },
