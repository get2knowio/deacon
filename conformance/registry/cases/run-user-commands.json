    {
      "id": "case-run-user-commands-feature-hook-sequence",
      "behaviors": [
        "bhv-run-user-commands-hook-order"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "run-user-commands",
        "sdim-config-source": "image",
        "sdim-container-state": "running",
        "sdim-features": "single",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "valid",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-ruc-image-feature"
          ]
        },
        {
          "id": "op-ruc",
