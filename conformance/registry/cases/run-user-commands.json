      },
      "inputClass": "reference-lenient",
      "errorPathTier": true,
      "oracleType": "live-differential",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-errorpath-ruc-late-hooks"
          ]
        },
        {
          "id": "op-ruc",
          "subcommand": "run-user-commands",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--override-config",
            "${WORKSPACE}/.devcontainer/post-start-failing.json"
          ],
          "expectFailurePhase": "lifecycle:postStart"
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-ruc"
        }
      ],
      "allowedDifferences": [
        {
          "behavior": "bhv-run-user-commands-hook-failure",
          "context": [],
          "observablePath": "chan-exit-code.exitCode",
          "rationale": "deacon re-runs the configured lifecycle commands on every invocation and propagates the hook's non-zero exit; the reference skips a hook the container has already completed and reports success without running it.",
          "waiverId": "wvr-ruc-completed-hooks-not-rerun"
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "Error-path tier, lifecycle stage, at `postStartCommand` — the LAST blocking hook, and the one whose failure is easiest to drop: it runs after the container is already usable, so an implementation that reports success once the container is up satisfies every earlier hook's case and not this one. Same shape and same characterized divergence as the `updateContentCommand` case (`wvr-ruc-completed-hooks-not-rerun`), kept separate because the two hooks fail at different points in the sequence. Direction pinned by `case-errorpath-ruc-post-start-failure-direction`."
    },
