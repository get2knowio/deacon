    {
      "id": "case-run-user-commands-feature-contributed-hook",
      "behaviors": [
        "bhv-run-user-commands-hook-order"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "run-user-commands",
        "sdim-config-source": "image",
        "sdim-container-state": "running",
        "sdim-features": "single",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "valid",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-ruc-image-feature"
          ]
        },
        {
          "id": "op-ruc",
          "subcommand": "run-user-commands",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ]
        },
        {
          "id": "op-read-feature-hook",
          "subcommand": "exec",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--",
            "grep",
            "-c",
            "feature-postCreate",
            "/tmp/conformance-hooks"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-read-feature-hook",
          "assertion": {
            "equals": 0
          }
        },
        {
          "channel": "chan-stdout",
          "operation": "op-read-feature-hook",
          "assertion": {
            "contains": "1"
          }
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "FR-037, the Feature-contributed half: the installed Feature declares its own `postCreateCommand`, and it must run exactly ONCE. `grep -c` rather than a presence check is deliberate — a Feature hook that runs on every invocation instead of once is present either way, and presence is what a weaker assertion would confirm."
    },
    {
      "id": "case-run-user-commands-feature-hook-sequence",
      "behaviors": [
        "bhv-run-user-commands-hook-order"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "run-user-commands",
        "sdim-config-source": "image",
        "sdim-container-state": "running",
        "sdim-features": "single",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "valid",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-ruc-image-feature"
          ]
        },
        {
          "id": "op-ruc",
          "subcommand": "run-user-commands",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ]
        },
        {
          "id": "op-read-hooks",
          "subcommand": "exec",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--",
            "cat",
            "/tmp/conformance-hooks"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-read-hooks",
          "assertion": {
            "equals": 0
          }
        },
        {
          "channel": "chan-stdout",
          "operation": "op-read-hooks",
          "assertion": {
            "matches": "config-onCreate[\\s\\S]*config-updateContent[\\s\\S]*config-postCreate[\\s\\S]*config-postStart"
          }
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "FR-037, the ordering half. Each hook appends its own name to a file inside the container, so the file IS the observed order — `onCreate`, then `updateContent`, then `postCreate`, then `postStart`. An exit code cannot distinguish 'ran in order' from 'ran at all', and the Feature-contributed `postCreateCommand` is asserted by its own sibling case so a failure names which of the two facts broke."
    },
    {
      "id": "case-run-user-commands-hook-failure",
      "behaviors": [
        "bhv-run-user-commands-hook-failure"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "run-user-commands",
        "sdim-config-source": "image",
        "sdim-container-state": "running",
        "sdim-features": "none",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "malformed",
      "oracleType": "live-differential",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-ruc-hook-failure"
          ]
        },
        {
          "id": "op-ruc",
          "subcommand": "run-user-commands",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--override-config",
            "${WORKSPACE}/.devcontainer/failing.json"
          ],
          "expectFailurePhase": "lifecycle:postCreate"
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-ruc"
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "FR-037 hook failure: `postCreateCommand` exits 23, and the run must fail rather than report success for a container whose setup did not complete. The failing configuration is supplied as an override so the preceding `up` can succeed — a hook failure during creation is a different case, and conflating them would leave neither pinned."
    },
