            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-exec-tty"
          ]
        },
        {
          "id": "op-exec",
          "subcommand": "exec",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--",
            "sh",
            "-lc",
            "test -t 1 && echo TTY || echo NOTTY"
          ]
        }
      ],
      "expected": [
