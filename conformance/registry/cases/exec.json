    {
      "id": "case-exec-boundary-empty-command-output",
      "behaviors": [
        "bhv-exec-command-parity"
      ],
      "context": [],
      "scenarioContext": {
        "sdim-operation": "exec",
        "sdim-config-source": "image",
        "sdim-container-state": "running",
        "sdim-features": "none",
        "sdim-layering": "single",
        "sdim-output-mode": "human"
      },
      "inputClass": "boundary",
      "oracleType": "live-differential",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-up",
          "subcommand": "up",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}"
          ],
          "fixtures": [
            "fx-exec-tty"
          ]
        },
        {
          "id": "op-exec",
          "subcommand": "exec",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--",
            "sh",
            "-c",
            "exit 0"
          ]
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-exec"
        },
        {
          "channel": "chan-stdout",
          "operation": "op-exec"
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "FR-040 boundary class for `exec`: a command that succeeds and writes NOTHING. Empty output is the edge of the stdout domain and is a different observation from output that was not captured — the distinction `present: false` exists to keep, and the one a comparison that treats empty as absent would silently lose."
    },
