          "context": [],
          "observablePath": "chan-exit-code.exitCode",
          "rationale": "deacon rejects the document before a container exists, so the exec never runs; the reference execs successfully in the container it created.",
          "waiverId": "wvr-wrong-type-forwardports"
        }
      ],
      "cleanup": {
