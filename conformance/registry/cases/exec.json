      },
      "inputClass": "malformed",
      "oracleType": "spec-expectation",
      "resourceGroup": "docker-shared",
      "operations": [
        {
          "id": "op-exec",
          "subcommand": "exec",
          "argv": [
            "--workspace-folder",
            "${WORKSPACE}",
            "--",
            "true"
          ],
          "fixtures": [
            "fx-errors-malformed-json"
          ],
          "expectFailurePhase": "config-resolution"
        }
      ],
      "expected": [
        {
          "channel": "chan-exit-code",
          "operation": "op-exec",
          "assertion": {
            "nonZero": true
          }
        }
      ],
      "cleanup": {
        "containers": true,
        "images": false,
        "networks": true,
        "volumes": true,
        "tempdir": true
      },
      "notes": "FR-040 malformed class for `exec`: the target container is identified from the configuration, so a document that cannot be parsed stops the run before any container is looked up. The container-state is `none` deliberately — the case never gets far enough for one to exist."
    },
