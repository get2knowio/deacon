    {
      "id": "clc-features-applications-should-default-to-bin-sh-for-featur-desc-025df47e",
      "clause": "clu-features-applications-should-default-to-bin-sh-for-featur-desc-025df47e",
      "disposition": "non-testable",
      "rationale": "A defaulting rule for the shell an installer picks when a Feature declares none. deacon does not pick a shell: it sets the execute bit and runs `install.sh` directly, so the script's own shebang selects the interpreter and there is no default for deacon to apply or get wrong. What the rule protects — the Feature installing successfully — is claimed by bhv-up-feature-install-order and bhv-up-feature-install-failure."
    },
