    {
      "id": "clc-features-the-properties-supporting-devcontainerid-in-the-desc-49ac4346",
      "clause": "clu-features-the-properties-supporting-devcontainerid-in-the-desc-49ac4346",
      "disposition": "non-testable",
      "rationale": "A scope enumeration listing which Feature-metadata properties admit `${devcontainerId}`; it states no outcome. The properties it names (`entrypoint`, `mounts`, `customizations`) are observed through their effects by bhv-up-feature-entrypoint-chain and bhv-up-mount-source-and-shape."
    },
    {
      "id": "clc-features-they-must-ensure-that-it-is-unique-among-other-d-desc-3180a890",
      "clause": "clu-features-they-must-ensure-that-it-is-unique-among-other-d-desc-3180a890",
      "disposition": "non-testable",
      "rationale": "Uniqueness across the dev containers on one host and stability across rebuilds, restated here from devcontainer-id-variable. Neither has an observation, because `${devcontainerId}` reaches a channel only where an author substituted it into some other value; the identifier is not itself a reported field of any consumer subcommand."
    },
    {
      "id": "clc-features-to-ensure-that-the-appropriate-shell-is-used-the-desc-69c662f2",
      "clause": "clu-features-to-ensure-that-the-appropriate-shell-is-used-the-desc-69c662f2",
      "disposition": "non-testable",
      "rationale": "Prescribes HOW an installer invokes `install.sh` (set the execute bit, invoke the file directly) so the script's own shebang selects the shell. The mechanics are internal to the install step and appear on no channel; the outcome they protect is claimed by bhv-up-feature-install-order and bhv-up-feature-install-failure."
    },
    {
      "id": "clc-features-use-a-base-32-encoded-representation-left-padded-algo-cf1473ea",
      "clause": "clu-features-use-a-base-32-encoded-representation-left-padded-algo-cf1473ea",
      "disposition": "non-testable",
      "rationale": "The output-encoding step of the label-based `${devcontainerId}` derivation, restated here from devcontainer-id-variable. Like the other steps of that computation it has no observation independent of the derived identifier itself."
    },
    {
      "id": "clc-templates-a-path-is-relative-to-the-root-of-the-template-s-desc-ec433cf4",
      "clause": "clu-templates-a-path-is-relative-to-the-root-of-the-template-s-desc-ec433cf4",
      "disposition": "non-testable",
      "rationale": "A notation rule for an `optionalPaths` entry (relative to the Template source root). `optionalPaths` is consumed only by the prompt-driven inclusion step the same section requires; deacon implements no `optionalPaths` handling at all (no occurrence anywhere in crates/) and applies every file the Template ships, so there is no inclusion decision for the notation to steer."
    },
    {
      "id": "clc-templates-a-supporting-tool-will-parse-the-options-object-desc-71357a1f",
      "clause": "clu-templates-a-supporting-tool-will-parse-the-options-object-desc-71357a1f",
      "disposition": "behavior-mapped",
      "behaviors": [
        "bhv-templates-apply-scaffolds-options"
      ]
    },
    {
      "id": "clc-templates-before-applying-a-template-tooling-must-inspect-desc-1eb54b25",
      "clause": "clu-templates-before-applying-a-template-tooling-must-inspect-desc-1eb54b25",
      "disposition": "non-testable",
      "rationale": "Requires the applying tool to PROMPT the user about each `optionalPaths` entry before applying. Prompting is an interactive-UI obligation: deacon's apply path is non-interactive by design (DEACON_NO_PROMPT fails closed rather than asking), so there is no prompt for a channel to observe and no answer a declarative operation could supply."
    },
    {
      "id": "clc-templates-for-a-directory-provide-the-full-relative-path-w-desc-6f870ac2",
      "clause": "clu-templates-for-a-directory-provide-the-full-relative-path-w-desc-6f870ac2",
      "disposition": "non-testable",
      "rationale": "The `/*` suffix notation for naming a directory in `optionalPaths`. Same ground as the other two `optionalPaths` clauses: the notation is only ever read by the prompt-driven inclusion step, which deacon does not implement and could not observe non-interactively."
    },
