    {
      "id": "clc-feature-dependencies-to-speed-up-dependency-resolution-all-features-p-desc-9ea95360",
      "clause": "clu-feature-dependencies-to-speed-up-dependency-resolution-all-features-p-desc-9ea95360",
      "disposition": "not-applicable",
      "rationale": "Describes what the publishing side does — the whole `devcontainer-feature.json` is serialized into an OCI annotation when a Feature is published — as a resolution-speed optimization for consumers. Publishing is permanently out of deacon's scope (constitution II), and deacon reads Feature metadata by fetching and extracting the Feature rather than from the annotation."
