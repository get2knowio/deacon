{
	"name": "Feature dependency ordering",
	"image": "alpine:3.18",
	"remoteUser": "root",
	"workspaceFolder": "/workspace",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
	"features": {
		"./.devcontainer/feature-app": {},
		"./.devcontainer/feature-base": {},
		"./.devcontainer/feature-lib": {}
	}
}
