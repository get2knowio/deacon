{
	"name": "ParityRunUserCommandsContainerIdLabelSubstitution",
	"image": "alpine:3.19",
	"remoteEnv": {
		"LENV": "${localEnv:PARITY_HOST_VALUE}",
		"LWF": "${localWorkspaceFolder}",
		"LWFB": "${localWorkspaceFolderBasename}"
	},
	"postAttachCommand": "printf '%s LENV=[%s] LWF=[%s] LWFB=[%s]\\n' 'CMD=[${localWorkspaceFolder}|${localWorkspaceFolderBasename}|${localEnv:PARITY_HOST_VALUE}]' \"$LENV\" \"$LWF\" \"$LWFB\" >> /tmp/parity-hook.log"
}
