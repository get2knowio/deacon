	"name": "ConformanceSetUpContainerWorkspaceFolderAuthoredOverlay",
	"workspaceFolder": "/work",
	"remoteEnv": {
		"PROBE_CONTAINER_WS": "${containerWorkspaceFolder}",
		"PROBE_CONTAINER_WS_BASENAME": "${containerWorkspaceFolderBasename}"
